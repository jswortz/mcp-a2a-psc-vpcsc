      "inputSchema": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "description": "Ledger record identifier"
          }
        },
        "required": ["record_id"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ]
